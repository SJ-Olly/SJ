# Headers for drag-and-drop deploys (netlify.toml headers only apply to builds).
/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin

# While the design is under review, never let browsers hold stale CSS or JS.
/css/*
  Cache-Control: no-cache

/js/*
  Cache-Control: no-cache
